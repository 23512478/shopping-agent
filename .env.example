# ===== 数据库（postgres 容器 + backend 连接）=====
# compose 里 DATABASE_URL 会自动用这三个变量拼接，一般只改这三个就行
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=shopping

# 如需自定义完整连接串（覆盖自动拼接），取消下面这行注释并填写
# DATABASE_URL=postgresql://agent:change-me@postgres:5432/shopping

# ===== 中间件 =====
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000
MCP_URL=http://mcp:9000

# ===== 步骤 22：认证 / CORS / 限流 =====
# 生产必须设一个长随机串（如 openssl rand -hex 32）；留空=开发模式不校验
API_TOKEN=
# 匿名用户身份 token 的 HMAC 密钥（⑦）：生产必须设一个长随机串；留空用开发默认值，谁都能伪造身份
USER_TOKEN_SECRET=
# 逗号分隔；生产填实际前端域名，如 https://shop.example.com
CORS_ORIGINS=https://shop.example.com
# 每客户端每分钟请求上限
RATE_LIMIT_PER_MIN=60

# ===== LLM（可选，不配走关键词兜底）=====
# OpenAI 兼容接口均可，如硅基流动 https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2

# ===== 京东联盟（可选，不配 mcp 用 mock 数据源）=====
# 导购媒体管理页发的 appkey/secretkey，配了就用京粉频道真实商品池
JD_APP_KEY=
JD_SECRET_KEY=

# ===== 生产部署（docker-compose.prod.yml 用）=====
# 对外域名，nginx 反代 + SSL 用
DOMAIN=shop.example.com
# 证书在 nginx 容器内的路径（宿主机 ./certs 挂载到 /etc/nginx/certs）
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
